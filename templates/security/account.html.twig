{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/account.css') }}">
{% endblock %}

{% block body %}

<section class="account-container">

    <div class="account-left">
        <h1>Mon compte</h1>

        <p>
            Bonjour 
            <strong>
                {% if user.nom %}
                    {{ user.nom }}
                {% else %}
                    {{ user.email }}
                {% endif %}
            </strong>
        </p>

        <section class="account-section">
            <h2>Nom d’utilisateur</h2>
            <p>Ce nom sera utilisé pour vos réservations et vos publications de photos.</p>

            {{ form_start(nameForm) }}
                {{ form_widget(nameForm) }}
                <button type="submit" class="btn">Mettre à jour</button>
            {{ form_end(nameForm) }}
        </section>

        <section class="account-section">
            <h2>Changer mon mot de passe</h2>

            {{ form_start(passwordForm) }}
                {{ form_widget(passwordForm) }}
                <button type="submit" class="btn">Changer le mot de passe</button>
            {{ form_end(passwordForm) }}
        </section>

        <a href="{{ path('app_logout') }}" class="btn">Se déconnecter</a>

    </div>

    <div class="account-right">
        <h2>Mes réservations</h2>

        {% if reservations is empty %}
            <p>Aucune réservation en cours.</p>
        {% else %}
            <ul>
                {% for reservation in reservations %}
                    <li>
                        Réservation pour {{ reservation.nombrePersonnes }} personne{% if reservation.nombrePersonnes > 1 %}s{% endif %}
                        le {{ reservation.datetimeReservation|date('d/m/Y') }} à {{ reservation.datetimeReservation|date('H:i') }}
                        <a href="{{ path('reservation_delete', {id: reservation.id}) }}" class="btn delete-btn">
                            Supprimer
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <h2>Mes photos</h2>
        <p>Vous voulez nous partager un souvenir? Ajoutez vos photos ici! </p>
        <p>Vos photos seront visibles sur la page photos après validation par un administrateur.</p>

        {{ form_start(photoForm, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_errors(photoForm) }}
            {{ form_row(photoForm.photo) }}
            <button type="submit" class="btn">Envoyer la photo</button>
        {{ form_end(photoForm) }}

        {% if photos is not defined or photos is empty %}
            <p>Vous n'avez encore envoyé aucune photo.</p>
        {% else %}
            <ul class="photo-list">
                {% for photo in photos %}
                    <li>
                        <img src="{{ photo.cheminFichier }}" alt="Photo envoyée">
                        {% if photo.isValidee %}
                            <span class="badge ok">Validée</span>
                        {% else %}
                            <span class="badge pending">En attente</span>
                        {% endif %}
                        <form method="post"
                            action="{{ path('photo_delete', {id: photo.id}) }}"
                            onsubmit="return confirm('Supprimer cette photo ?');">
                            <button type="submit" class="btn delete-btn">Supprimer</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        </div>

</section>

{% endblock %}