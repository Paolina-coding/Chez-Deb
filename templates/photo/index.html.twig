{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/photos.css') }}">
{% endblock %}

{% block body %}
<h1 class="photo-title">Galerie photo</h1>

<p class="photos-intro">
    Partagez vos meilleurs moments !<br>
    <a href="{{ path('app_login') }}">Connectez‑vous ici</a> et ajoutez vos photos : une fois validées, elles rejoindront la galerie du bar.<br>
    Montrez-nous vos soirées, vos cocktails préférés, vos sourires… cette galerie, c’est aussi la vôtre !
</p>

<div class="photos-container">
    {% for photo in photos %}
        <div class="photo-item" data-lightbox-src="{{ photo.cheminFichier }}">
            <img src="{{ photo.cheminFichier }}" alt="{{ photo.nomFichier }}" loading="lazy">
        </div>
    {% endfor %}
</div>

<div id="lightbox" class="lightbox">
    <img id="lightbox-img" src="" alt="Photo">
</div>

{% endblock %}