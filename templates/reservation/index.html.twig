{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/reservation.css') }}">
{% endblock %}

{% block body %}

<section class="reservation-contact">

    <div class="reservation-block">
        <h1>Réserver une table</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'reservation-form'}}) }}

            {{ form_label(form.nomClient, 'Nom de la réservation') }}
            {{ form_widget(form.nomClient, {'attr': {'placeholder': 'Votre nom'}}) }}
            {{ form_errors(form.nomClient) }}

            {{ form_label(form.nombrePersonnes, 'Nombre de personnes') }}
            {{ form_widget(form.nombrePersonnes, {'attr': {'min': 1, 'placeholder': 'Ex : 4'}}) }}
            {{ form_errors(form.nombrePersonnes) }}

            {{ form_label(form.datetimeReservation, 'Date et heure') }}
            {{ form_widget(form.datetimeReservation) }}
            {{ form_errors(form.datetimeReservation) }}

            {{ form_label(form.telephoneClient, 'Numéro de téléphone (pour vous recontacter)') }}
            {{ form_widget(form.telephoneClient, {'attr': {'placeholder': 'Ex : 07 12 34 56 78'}}) }}
            {{ form_errors(form.telephoneClient) }}

            <button type="submit" class="btn">Réserver</button>

        {{ form_end(form) }}
        
    </div>

    <div class="contact-block">
        <h1>Nous contacter</h1>
        <p>
            Pour toute réservation de table en intérieur, privatisation du dimanche ou autre question,
            merci de contacter ce numéro :
        </p>
        <p class="contact-phone">07 51 62 91 39</p>
    </div>

</section>

{% endblock %}
