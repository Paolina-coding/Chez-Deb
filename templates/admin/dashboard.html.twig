{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}

<section class="admin-container">

    <div class="admin-header">
        <h1>Administration</h1>
    </div>

    <h2>Réservations à venir</h2>

    {% if reservations is empty %}
        <p>Aucune réservation à venir.</p>
    {% else %}
        <ul class="admin-list">
            {% for reservation in reservations %}
                <li class="admin-item">
                    <strong>{{ reservation.nomClient }}</strong><br>

                    Réservation pour 
                    <strong>{{ reservation.nombrePersonnes }}</strong> personne{% if reservation.nombrePersonnes > 1 %}s{% endif %}
                    le 
                    <strong>{{ reservation.datetimeReservation|date('d/m/Y') }}</strong>
                    à 
                    <strong>{{ reservation.datetimeReservation|date('H:i') }}</strong><br>

                    Téléphone : <strong>{{ reservation.telephoneClient }}</strong><br>
                    <a href="{{ path('admin_delete_reservation', { id: reservation.id }) }}" class="btn admin-btn" onclick="return confirm('Supprimer cette réservation ?');">
                    Supprimer
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2>Photos en attente de validation</h2>

    {% if photosEnAttente is empty %}
        <p>Aucune photo en attente.</p>
    {% else %}
        <ul class="admin-list photo-admin-list">
            {% for photo in photosEnAttente %}
                <li class="admin-item">
                    <img src="{{ photo.cheminFichier }}" alt="Photo en attente">
                    <p>
                        Envoyée par
                        <strong>{{ photo.utilisateur.nom ?: photo.utilisateur.email }}</strong>
                        le <strong>{{ photo.dateCreation|date('d/m/Y à H:i') }}</strong>
                    </p>
                    <div class="photo-actions">
                        <form method="post" action="{{ path('admin_validate_photo', {id: photo.id}) }}">
                            <button type="submit" class="btn admin-btn">Valider</button>
                        </form>
                        <form method="post"
                            action="{{ path('admin_reject_photo', {id: photo.id}) }}"
                            onsubmit="return confirm('Refuser et supprimer définitivement cette photo ?');">
                            <button type="submit" class="btn admin-btn delete-btn">Refuser</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2>Photos validées</h2>

    {% if photosValidees is empty %}
        <p>Aucune photo validée.</p>
    {% else %}
        <ul class="admin-list photo-admin-list">
            {% for photo in photosValidees %}
                <li class="admin-item">
                    <img src="{{ photo.cheminFichier }}" alt="Photo validée">
                    <p>
                        Envoyée par
                        <strong>{{ photo.utilisateur.nom ?: photo.utilisateur.email }}</strong>
                        le <strong>{{ photo.dateCreation|date('d/m/Y à H:i') }}</strong>
                    </p>
                    <form method="post"
                        action="{{ path('admin_delete_photo', {id: photo.id}) }}"
                        onsubmit="return confirm('Supprimer définitivement cette photo ?');">
                        <button type="submit" class="btn admin-btn delete-btn">Supprimer</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    
    <h2>Utilisateurs</h2>
    <a href="{{ path('admin_users') }}" class="btn">Voir les utilisateurs</a>

</section>

{% endblock %}