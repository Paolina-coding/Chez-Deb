<!DOCTYPE html>
<html lang="fr">
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Chez Deb{% endblock %}</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cutive+Mono&display=swap">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>

    <body>

        <header class="main-header">
            <div class="header-content">
                <a href="/" class="logo-link">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo Chez Deb" class="logo">
                </a>

                <nav class="nav">
                    <a href="/a-propos">La petite histoire</a>
                    <a href="/carte">Carte</a>
                    <a href="/reservations">Réservation et contact</a>
                    <a href="/photos">Photos</a>
                </nav>
            </div>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="main-footer">
            <div class="footer-content">

                <!-- Bloc horaires -->
                <div class="footer-hours">
                    <h3>Horaires</h3>
                    <p>Lundi : Fermé</p>
                    <p>Mardi : 17:00 - 00:00</p>
                    <p>Mercredi : 17:00 - 00:00</p>
                    <p>Jeudi : 17:00 - 02:00</p>
                    <p>Vendredi : 17:00 - 03:00</p>
                    <p>Samedi : 17:00 - 03:00</p>
                    <p>Dimanche : Fermé (privatisation possible)</p>
                </div>

                <!-- Réseaux sociaux -->
                <div class="footer-social">
                    <a href="https://www.facebook.com/p/Chez-Deb-61580555819416/" target="_blank" class="social-icon">
                        <svg class="icon-facebook" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                d="M20 1C21.6569 1 23 2.34315 23 4V20C23 21.6569 21.6569 23 20 23H4C2.34315 23 1 21.6569 1 20V4C1 2.34315 2.34315 1 4 1H20ZM20 3C20.5523 3 21 3.44772 21 4V20C21 20.5523 20.5523 21 20 21H15V13.9999H17.0762C17.5066 13.9999 17.8887 13.7245 18.0249 13.3161L18.4679 11.9871C18.6298 11.5014 18.2683 10.9999 17.7564 10.9999H15V8.99992C15 8.49992 15.5 7.99992 16 7.99992H18C18.5523 7.99992 19 7.5522 19 6.99992V6.31393C19 5.99091 18.7937 5.7013 18.4813 5.61887C17.1705 5.27295 16 5.27295 16 5.27295C13.5 5.27295 12 6.99992 12 8.49992V10.9999H10C9.44772 10.9999 9 11.4476 9 11.9999V12.9999C9 13.5522 9.44771 13.9999 10 13.9999H12V21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3H20Z"/>
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/chezdeb" target="_blank" class="social-icon">
                        <svg class="icon-instagram" viewBox="0 0 32 32">
                            <path d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z"/>
                            <path d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8 c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z"/>
                            <path d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8 c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z"/>
                        </svg>
                    </a>

                </div>

                <!-- Navigation -->
                <div class="footer-nav">
                    <a href="/a-propos">La petite histoire</a>
                    <a href="/carte">Carte</a>
                    <a href="/reservations">Réservation et contact</a>
                    <a href="/photos">Photos</a>
                </div>

            </div>
        </footer>


    </body>
</html>
